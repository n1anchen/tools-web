{
  "name": "rbl-tools-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --max_old_space_size=8192 node_modules/vite/bin/vite.js build --mode production",
    "build:esa": "esbuild esa-functions/url-unshorten/index.js --bundle --format=esm --platform=neutral --target=es2022 --outfile=esa-functions/url-unshorten/dist/index.js",
    "build:pro": "pnpm build",
    "build:check": "vue-tsc --noEmit --skipLibCheck -p tsconfig.json && tsc --noEmit --skipLibCheck -p tsconfig.node.json && pnpm build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "copy-assets": "node scripts/copy-assets.js",
    "clean-assets": "rimraf public/fonts public/ace public/dicts",
    "postinstall": "node scripts/copy-assets.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vicons/fa": "^0.13.0",
    "@vicons/utils": "^0.1.4",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@zip.js/zip.js": "^2.8.23",
    "ace-builds": "^1.43.5",
    "axios": "^1.18.1",
    "colord": "^2.9.3",
    "coordtransform": "^2.1.2",
    "cron-chinese": "^1.2.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.12.0",
    "crypto-js": "^4.2.0",
    "csso": "^5.0.5",
    "diff": "^8.0.3",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.14.3",
    "exifr": "^7.1.3",
    "fabric": "^7.4.0",
    "figlet": "^1.9.4",
    "hls.js": "^1.6.16",
    "imorse": "^1.0.0",
    "jwt-decode": "^4.0.0",
    "kuromoji": "0.1.2",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "lzma": "^2.3.2",
    "md-editor-v3": "^6.5.4",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "qrcode-vue3": "^1.7.1",
    "sql-formatter": "^15.8.0",
    "terser": "^5.46.0",
    "ts-md5": "^1.3.1",
    "tui-image-editor": "^3.15.3",
    "uuid": "^14.0.1",
    "vue": "^3.5.40",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "^4.6.4",
    "wanakana": "^5.3.1",
    "workbox-window": "^7.4.0",
    "x-data-spreadsheet": "^1.1.9",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zlibjs": "0.3.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/lzma": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "less": "^4.5.1",
    "lightningcss": "^1.31.1",
    "rimraf": "^6.1.2",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.14",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.2.2"
  }
