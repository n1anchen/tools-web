# 变量必须以 VITE_ 为前缀才能暴露给前端代码读取
# 网站名称
VITE_APP_TITLE = 'Tools-Web'
# 简短描述
VITE_APP_DESC = '一个轻量的在线工具箱'
# base api
VITE_APP_BASE_API = '/v1'
# 服务端地址，例如 https://api.example.com；纯静态部署可留空
VITE_SERVE = ''
# 自定义启动host
VITE_HOST = '127.0.0.1'
# 页脚备案信息
VITE_SITE_ICP = ''
VITE_SITE_PRC = ''
# 百度站点验证 code（留空时不注入验证 meta）
VITE_BAIDU_SITE_CODE = ''
# 短链接解析云函数地址（阿里云 ESA 边缘函数）
# 部署 esa-functions/url-unshorten/index.js 后填写对应的函数 URL
# 不填写则页面禁用短链接解析功能
VITE_UNSHORTEN_API = ''
# 直接通过 URL 进入工具页时默认收起侧边栏（'true' 开启；留空或 'false' 保持展开）
VITE_COLLAPSE_SIDEBAR_ON_TOOL_ENTRY = ''
